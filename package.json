{
  "name": "openui.mbt",
  "version": "0.1.10",
  "private": true,
  "description": "MoonBit parser for OpenUI Lang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyq02/openui.mbt.git"
  },
  "license": "MIT",
  "author": "Ari <mail@heyq02.cn>",
  "type": "module",
  "scripts": {
    "automd": "automd",
    "benchmark": "node scripts/benchmark.mjs",
    "build:parser": "moon build --target wasm-gc --release && node npm/build.mjs",
    "build:rsdoctor": "moon build --target wasm-gc --release && node npm/build.mjs && rs lib",
    "commitlint": "commitlint",
    "compare": "node npm/compare.mjs",
    "format": "automd && rs fmt",
    "format:check": "rs fmt --check",
    "prepare": "rs hooks",
    "release": "bumpp",
    "test": "moon test --target native --deny-warn"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@heyq02/rstack-config": "^0.0.6",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "automd": "^0.4.3",
    "bumpp": "^12.3.0",
    "oxfmt": "^0.73.0",
    "rstack": "^0.8.3",
    "vite-plus": "^1.2.0"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  }
}
