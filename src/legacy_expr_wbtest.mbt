///|
test "numeric tokens follow the official expression parser" {
  inspect(parse_expression_json("[]"), content="{\"k\":\"Null\"}")
  inspect(parse_expression_json("[{\"t\":13}]"), content="{\"k\":\"Null\"}")
  inspect(parse_expression_json("{\"t\":16}"), content="{\"k\":\"Null\"}")
  inspect(parse_expression_json("}"), content="{\"k\":\"Null\"}")
  inspect(
    parse_expression_json("[{\"t\":16.5,\"s\":\"a\"}]"),
    content="{\"k\":\"Null\"}",
  )
  inspect(
    parse_expression_json("[{\"t\":14,\"s\":\"hi\"}]"),
    content="{\"k\":\"Str\",\"at\":0}",
  )
  inspect(
    parse_expression_json("[{\"t\":15}]"),
    content="{\"k\":\"Num\",\"at\":0}",
  )
  inspect(
    parse_expression_json("[{\"t\":10}]"),
    content="{\"k\":\"Bool\",\"v\":true}",
  )
  inspect(
    parse_expression_json("[{\"t\":11}]"),
    content="{\"k\":\"Bool\",\"v\":false}",
  )
  inspect(parse_expression_json("[{\"t\":12}]"), content="{\"k\":\"Null\"}")
  inspect(
    parse_expression_json(
      "[{\"t\":16,\"s\":\"a\"},{\"t\":20},{\"t\":15},{\"t\":22},{\"t\":15}]",
    ),
    content="{\"k\":\"BinOp\",\"op\":\"+\",\"left\":{\"k\":\"Ref\",\"at\":0},\"right\":{\"k\":\"BinOp\",\"op\":\"*\",\"left\":{\"k\":\"Num\",\"at\":2},\"right\":{\"k\":\"Num\",\"at\":4}}}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":16,\"s\":\"a\"},{\"t\":34},{\"t\":16,\"s\":\"b\"},{\"t\":34},{\"t\":16,\"s\":\"c\"},{\"t\":8},{\"t\":16,\"s\":\"d\"},{\"t\":8},{\"t\":16,\"s\":\"e\"}]",
    ),
    content="{\"k\":\"Ternary\",\"cond\":{\"k\":\"Ref\",\"at\":0},\"then\":{\"k\":\"Ternary\",\"cond\":{\"k\":\"Ref\",\"at\":2},\"then\":{\"k\":\"Ref\",\"at\":4},\"else\":{\"k\":\"Ref\",\"at\":6}},\"else\":{\"k\":\"Ref\",\"at\":8}}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":16,\"s\":\"a\"},{\"t\":34},{\"t\":16,\"s\":\"b\"},{\"t\":16,\"s\":\"c\"}]",
    ),
    content="{\"k\":\"Ternary\",\"cond\":{\"k\":\"Ref\",\"at\":0},\"then\":{\"k\":\"Ref\",\"at\":2},\"else\":{\"k\":\"Ref\",\"at\":3}}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":17,\"s\":\"Card\"},{\"t\":1},{\"t\":15},{\"t\":15},{\"t\":2}]",
    ),
    content="{\"k\":\"Comp\",\"at\":0,\"args\":[{\"k\":\"Num\",\"at\":2},{\"k\":\"Num\",\"at\":3}]}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":17,\"s\":\"Count\"},{\"t\":1},{\"t\":16,\"s\":\"items\"},{\"t\":2}]",
    ),
    content="{\"k\":\"Ref\",\"at\":0}",
  )
  inspect(
    parse_expression_json("[{\"t\":17,\"s\":\"Action\"},{\"t\":1},{\"t\":2}]"),
    content="{\"k\":\"Comp\",\"at\":0,\"args\":[]}",
  )
  inspect(
    parse_expression_json("[{\"t\":35,\"s\":\"Count\"},{\"t\":1},{\"t\":2}]"),
    content="{\"k\":\"Comp\",\"at\":0,\"args\":[]}",
  )
  inspect(
    parse_expression_json("[{\"t\":35,\"s\":\"Foo\"},{\"t\":1},{\"t\":2}]"),
    content="{\"k\":\"Comp\",\"at\":0,\"args\":[],\"fn\":true}",
  )
  inspect(
    parse_expression_json("[{\"t\":35},{\"t\":1}]"),
    content="{\"k\":\"Comp\",\"at\":0,\"args\":[],\"fn\":true}",
  )
  inspect(
    parse_expression_json("[{\"t\":17},{\"t\":1},{\"t\":2}]"),
    content="{\"k\":\"Comp\",\"at\":0,\"args\":[]}",
  )
  inspect(
    parse_expression_json("[{\"t\":18,\"s\":\"$count\"},{\"t\":9},{\"t\":15}]"),
    content="{\"k\":\"Assign\",\"at\":0,\"value\":{\"k\":\"Num\",\"at\":2}}",
  )
  inspect(
    parse_expression_json("[{\"t\":18,\"s\":\"$count\"}]"),
    content="{\"k\":\"StateRef\",\"at\":0}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":33},{\"t\":11},{\"t\":31},{\"t\":21},{\"t\":15}]",
    ),
    content="{\"k\":\"BinOp\",\"op\":\"&&\",\"left\":{\"k\":\"UnaryOp\",\"op\":\"!\",\"operand\":{\"k\":\"Bool\",\"v\":false}},\"right\":{\"k\":\"UnaryOp\",\"op\":\"-\",\"operand\":{\"k\":\"Num\",\"at\":4}}}",
  )
  inspect(
    parse_expression_json("[{\"t\":1},{\"t\":15}]"),
    content="{\"k\":\"Num\",\"at\":1}",
  )
  inspect(
    parse_expression_json("[{\"t\":3},{\"t\":4}]"),
    content="{\"k\":\"Arr\",\"els\":[]}",
  )
  inspect(
    parse_expression_json("[{\"t\":3},{\"t\":7},{\"t\":15},{\"t\":4}]"),
    content="{\"k\":\"Arr\",\"els\":[{\"k\":\"Null\"},{\"k\":\"Num\",\"at\":2}]}",
  )
  inspect(
    parse_expression_json("[{\"t\":5},{\"t\":6}]"),
    content="{\"k\":\"Obj\",\"entries\":[]}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":5},{\"t\":15},{\"t\":8},{\"t\":14,\"s\":\"a\"},{\"t\":6}]",
    ),
    content="{\"k\":\"Obj\",\"entries\":[{\"key\":{\"op\":\"str\",\"at\":1},\"value\":{\"k\":\"Str\",\"at\":3}}]}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":5},{\"t\":18,\"s\":\"$b\"},{\"t\":8},{\"t\":15},{\"t\":6}]",
    ),
    content="{\"k\":\"Obj\",\"entries\":[{\"key\":{\"op\":\"strip\",\"at\":1},\"value\":{\"k\":\"Num\",\"at\":3}}]}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":5},{\"t\":34},{\"t\":8},{\"t\":12},{\"t\":6}]",
    ),
    content="{\"k\":\"Obj\",\"entries\":[{\"key\":{\"op\":\"q\"},\"value\":{\"k\":\"Null\"}}]}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":16,\"s\":\"foo\"},{\"t\":19},{\"t\":18,\"s\":\"$bar\"}]",
    ),
    content="{\"k\":\"Member\",\"obj\":{\"k\":\"Ref\",\"at\":0},\"field\":{\"op\":\"strip\",\"at\":2}}",
  )
  inspect(
    parse_expression_json("[{\"t\":16,\"s\":\"foo\"},{\"t\":19},{\"t\":34}]"),
    content="{\"k\":\"Member\",\"obj\":{\"k\":\"Ref\",\"at\":0},\"field\":{\"op\":\"q\"}}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":16,\"s\":\"obj\"},{\"t\":19},{\"t\":16,\"s\":\"field\"},{\"t\":3},{\"t\":15},{\"t\":4}]",
    ),
    content="{\"k\":\"Index\",\"obj\":{\"k\":\"Member\",\"obj\":{\"k\":\"Ref\",\"at\":0},\"field\":{\"op\":\"str\",\"at\":2}},\"index\":{\"k\":\"Num\",\"at\":4}}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":16,\"s\":\"a\"},{\"t\":25},{\"t\":16,\"s\":\"b\"},{\"t\":26},{\"t\":16,\"s\":\"c\"}]",
    ),
    content="{\"k\":\"BinOp\",\"op\":\"!=\",\"left\":{\"k\":\"BinOp\",\"op\":\"==\",\"left\":{\"k\":\"Ref\",\"at\":0},\"right\":{\"k\":\"Ref\",\"at\":2}},\"right\":{\"k\":\"Ref\",\"at\":4}}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":15},{\"t\":21},{\"t\":15},{\"t\":23},{\"t\":15},{\"t\":24},{\"t\":15}]",
    ),
    content="{\"k\":\"BinOp\",\"op\":\"-\",\"left\":{\"k\":\"Num\",\"at\":0},\"right\":{\"k\":\"BinOp\",\"op\":\"%\",\"left\":{\"k\":\"BinOp\",\"op\":\"/\",\"left\":{\"k\":\"Num\",\"at\":2},\"right\":{\"k\":\"Num\",\"at\":4}},\"right\":{\"k\":\"Num\",\"at\":6}}}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":15},{\"t\":27},{\"t\":15},{\"t\":28},{\"t\":15}]",
    ),
    content="{\"k\":\"BinOp\",\"op\":\"<\",\"left\":{\"k\":\"BinOp\",\"op\":\">\",\"left\":{\"k\":\"Num\",\"at\":0},\"right\":{\"k\":\"Num\",\"at\":2}},\"right\":{\"k\":\"Num\",\"at\":4}}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":15},{\"t\":29},{\"t\":15},{\"t\":30},{\"t\":15},{\"t\":32},{\"t\":11}]",
    ),
    content="{\"k\":\"BinOp\",\"op\":\"||\",\"left\":{\"k\":\"BinOp\",\"op\":\"<=\",\"left\":{\"k\":\"BinOp\",\"op\":\">=\",\"left\":{\"k\":\"Num\",\"at\":0},\"right\":{\"k\":\"Num\",\"at\":2}},\"right\":{\"k\":\"Num\",\"at\":4}},\"right\":{\"k\":\"Bool\",\"v\":false}}",
  )
  inspect(
    parse_expression_json("[{\"t\":17,\"s\":\"Card\"}]"),
    content="{\"k\":\"Ref\",\"at\":0}",
  )
  inspect(
    parse_expression_json("[{\"t\":35,\"s\":\"Foo\"}]"),
    content="{\"k\":\"Ref\",\"at\":0}",
  )
  inspect(
    parse_expression_json("[{\"t\":5}]"),
    content="{\"k\":\"Obj\",\"entries\":[]}",
  )
  inspect(legacy_prec(19), content="9")
  inspect(legacy_prec(0), content="0")
  inspect(parse_expression_json("[{\"t\":36}]"), content="{\"k\":\"Null\"}")
  inspect(parse_expression_json("[{\"t\":-1}]"), content="{\"k\":\"Null\"}")
  inspect(parse_expression_json("[{\"t\":null}]"), content="{\"k\":\"Null\"}")
  inspect(parse_expression_json("[{}]"), content="{\"k\":\"Null\"}")
  inspect(parse_expression_json("[null]"), content="{\"k\":\"Null\"}")
  inspect(
    parse_expression_json(
      "[{\"t\":3},{\"t\":15},{\"t\":7},{\"t\":15},{\"t\":4}]",
    ),
    content="{\"k\":\"Arr\",\"els\":[{\"k\":\"Num\",\"at\":1},{\"k\":\"Num\",\"at\":3}]}",
  )
  inspect(
    parse_expression_json(
      "[{\"t\":5},{\"t\":16,\"s\":\"a\"},{\"t\":8},{\"t\":15},{\"t\":7},{\"t\":16,\"s\":\"b\"},{\"t\":8},{\"t\":15},{\"t\":6}]",
    ),
    content="{\"k\":\"Obj\",\"entries\":[{\"key\":{\"op\":\"str\",\"at\":1},\"value\":{\"k\":\"Num\",\"at\":3}},{\"key\":{\"op\":\"str\",\"at\":5},\"value\":{\"k\":\"Num\",\"at\":7}}]}",
  )
  let parser = LegacyExpr::{ pos: 0, toks: [{ t: 0, s: "", named: false, }], }
  inspect(
    parser.parse_infix(legacy_null()).stringify(),
    content="{\"k\":\"Null\"}",
  )
}
