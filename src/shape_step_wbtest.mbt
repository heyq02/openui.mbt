///|
test "schema validation chooses objects, arrays, leaves, and defaults" {
  inspect(
    shape_step("{\"phase\":\"gate\",\"bad\":true}"),
    content="{\"op\":\"keep\"}",
  )
  inspect(
    shape_step("{\"phase\":\"gate\",\"bad\":false}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"gate\",\"bad\":1}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"value\",\"nil\":true}"),
    content="{\"op\":\"keep\"}",
  )
  inspect(
    shape_step("{\"phase\":\"value\",\"nil\":false}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"ast\",\"ast\":true}"),
    content="{\"op\":\"keep\"}",
  )
  inspect(shape_step("{\"phase\":\"ast\"}"), content="{\"op\":\"go\"}")
  inspect(
    shape_step("{\"phase\":\"element\",\"element\":true}"),
    content="{\"op\":\"position\"}",
  )
  inspect(
    shape_step("{\"phase\":\"element\",\"element\":false}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"shape\",\"composite\":true}"),
    content="{\"op\":\"slot\"}",
  )
  inspect(
    shape_step("{\"phase\":\"shape\",\"composite\":false}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"kind\",\"object\":true}"),
    content="{\"op\":\"object\"}",
  )
  inspect(
    shape_step("{\"phase\":\"kind\",\"object\":false,\"array\":true}"),
    content="{\"op\":\"array\"}",
  )
  inspect(shape_step("{\"phase\":\"kind\"}"), content="{\"op\":\"leaf\"}")
  inspect(
    shape_step("{\"phase\":\"kind\",\"object\":\"yes\",\"array\":1}"),
    content="{\"op\":\"leaf\"}",
  )
  inspect(shape_step("{\"phase\":\"leaf\"}"), content="{\"op\":\"skip\"}")
  inspect(
    shape_step("{\"phase\":\"leaf\",\"typed\":true}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"leaf\",\"enums\":true}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"defer\",\"listed\":true,\"partial\":true}"),
    content="{\"op\":\"defer\"}",
  )
  inspect(
    shape_step("{\"phase\":\"defer\",\"listed\":true,\"partial\":false}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"defer\",\"listed\":false}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"miss\",\"bad\":true}"),
    content="{\"op\":\"bad\"}",
  )
  inspect(
    shape_step("{\"phase\":\"miss\",\"bad\":false}"),
    content="{\"op\":\"ok\"}",
  )
  inspect(
    shape_step("{\"phase\":\"place\",\"composite\":true}"),
    content="{\"op\":\"skip\"}",
  )
  inspect(shape_step("{\"phase\":\"place\"}"), content="{\"op\":\"go\"}")
  inspect(
    shape_step("{\"phase\":\"shaped\",\"shaped\":true}"),
    content="{\"op\":\"bad\"}",
  )
  inspect(
    shape_step("{\"phase\":\"shaped\",\"shaped\":0}"),
    content="{\"op\":\"ok\"}",
  )
  inspect(
    shape_step("{\"phase\":\"box\",\"bad\":true}"),
    content="{\"op\":\"mismatch\"}",
  )
  inspect(
    shape_step("{\"phase\":\"box\",\"bad\":false}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"props\",\"present\":true,\"object\":true}"),
    content="{\"op\":\"use\"}",
  )
  inspect(
    shape_step("{\"phase\":\"props\",\"present\":true,\"object\":false}"),
    content="{\"op\":\"empty\"}",
  )
  inspect(shape_step("{\"phase\":\"props\"}"), content="{\"op\":\"empty\"}")
  inspect(
    shape_step("{\"phase\":\"req\",\"list\":true}"),
    content="{\"op\":\"use\"}",
  )
  inspect(
    shape_step("{\"phase\":\"req\",\"list\":false}"),
    content="{\"op\":\"empty\"}",
  )
  inspect(
    shape_step("{\"phase\":\"need\",\"partial\":true}"),
    content="{\"op\":\"skip\"}",
  )
  inspect(
    shape_step("{\"phase\":\"need\",\"partial\":false}"),
    content="{\"op\":\"scan\"}",
  )
  inspect(shape_step("{\"phase\":\"hole\"}"), content="{\"op\":\"fill\"}")
  inspect(
    shape_step("{\"phase\":\"hole\",\"present\":true,\"nil\":true}"),
    content="{\"op\":\"fill\"}",
  )
  inspect(
    shape_step("{\"phase\":\"hole\",\"present\":true,\"nil\":false}"),
    content="{\"op\":\"keep\"}",
  )
  inspect(
    shape_step("{\"phase\":\"fill\",\"defined\":true}"),
    content="{\"op\":\"default\"}",
  )
  inspect(
    shape_step("{\"phase\":\"fill\",\"defined\":false}"),
    content="{\"op\":\"issue\"}",
  )
  inspect(
    shape_step("{\"phase\":\"edge\",\"invalid\":true}"),
    content="{\"op\":\"repair\"}",
  )
  inspect(
    shape_step("{\"phase\":\"edge\",\"invalid\":false}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"repair\",\"defined\":true,\"required\":true}"),
    content="{\"op\":\"keep\"}",
  )
  inspect(
    shape_step("{\"phase\":\"repair\",\"defined\":false,\"required\":true}"),
    content="{\"op\":\"invalid\"}",
  )
  inspect(shape_step("{\"phase\":\"repair\"}"), content="{\"op\":\"drop\"}")
  inspect(
    shape_step("{\"phase\":\"same\",\"same\":true}"),
    content="{\"op\":\"keep\"}",
  )
  inspect(
    shape_step("{\"phase\":\"same\",\"same\":false}"),
    content="{\"op\":\"copy\"}",
  )
  inspect(
    shape_step("{\"phase\":\"write\",\"nil\":true}"),
    content="{\"op\":\"delete\"}",
  )
  inspect(
    shape_step("{\"phase\":\"write\",\"nil\":false}"),
    content="{\"op\":\"set\"}",
  )
  inspect(
    shape_step("{\"phase\":\"done\",\"invalid\":true}"),
    content="{\"op\":\"invalid\"}",
  )
  inspect(
    shape_step("{\"phase\":\"done\",\"invalid\":false}"),
    content="{\"op\":\"keep\"}",
  )
  inspect(
    shape_step("{\"phase\":\"items\",\"bad\":true}"),
    content="{\"op\":\"keep\"}",
  )
  inspect(
    shape_step("{\"phase\":\"items\",\"bad\":false}"),
    content="{\"op\":\"walk\"}",
  )
  inspect(
    shape_step("{\"phase\":\"cell\",\"changed\":true,\"fresh\":true}"),
    content="{\"op\":\"copy\"}",
  )
  inspect(
    shape_step("{\"phase\":\"cell\",\"changed\":true,\"fresh\":false}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"cell\",\"changed\":false}"),
    content="{\"op\":\"go\"}",
  )
  inspect(
    shape_step("{\"phase\":\"push\",\"open\":true,\"valid\":true}"),
    content="{\"op\":\"push\"}",
  )
  inspect(
    shape_step("{\"phase\":\"push\",\"open\":true,\"valid\":false}"),
    content="{\"op\":\"skip\"}",
  )
  inspect(shape_step("{\"phase\":\"push\"}"), content="{\"op\":\"skip\"}")
  inspect(shape_step("{\"phase\":\"other\"}"), content="{\"op\":\"keep\"}")
  inspect(shape_step("{\"phase\":1}"), content="{\"op\":\"keep\"}")
  inspect(shape_step("[]"), content="{\"op\":\"keep\"}")
  inspect(shape_step("{"), content="{\"op\":\"keep\"}")
}
